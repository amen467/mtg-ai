// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Models

model Card {
  id               String   @id
  name             String
  oracleText       String?
  manaCost         String?
  typeLine         String?
  power            String?
  toughness        String?
  colors           String[]
  colorIdentity    String[]
  keywords         String[]
  cmc              Float?
  reserved         Boolean  @default(false)
  digital          Boolean  @default(false)
  imageUri         String?
  scryfallUri      String?

  printings        Printing[] @relation("CardPrintings")
  rulings Ruling[] @relation("CardRulings")
  legalities CardLegality[] @relation("CardLegalities")

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([name])
}

model Printing {
  id            String   @id
  cardId        String
  setCode       String
  setName       String
  collectorNumber String
  rarity        String?
  releasedAt    DateTime?
  imageUri      String?
  scryfallUri   String?

  card          Card @relation("CardPrintings", fields: [cardId], references: [id], onDelete: Cascade)

  createdAt     DateTime @default(now())

  @@unique([setCode, collectorNumber])
  @@index([cardId])
  @@index([setCode])
}

model Ruling {
  id          String   @id
  cardId      String
  source      String
  publishedAt DateTime
  comment     String

  card        Card     @relation("CardRulings", fields: [cardId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())

  @@index([cardId])
  @@index([publishedAt])
}

model ComprehensiveRule {
  id          String   @id
  ruleNumber  String   @unique
  section     String?
  title       String?
  text        String
  parentId    String?

  parent      ComprehensiveRule?  @relation("RuleHierarchy", fields: [parentId], references: [id])
  children    ComprehensiveRule[] @relation("RuleHierarchy")

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([section])
  @@index([parentId])
}

model ReleaseNote {
  id           String   @id
  setCode      String?
  releaseDate  DateTime?
  cardName     String?
  text         String
  sourceUrl    String?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([setCode])
  @@index([cardName])
  @@index([releaseDate])
}

model CardLegality {
  id          String   @id
  cardId      String
  format      String
  status      String
  effectiveAt DateTime
  sourceUrl   String?

  card        Card     @relation("CardLegalities", fields: [cardId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([cardId, format, effectiveAt])
  @@index([cardId])
  @@index([format])
  @@index([effectiveAt])
}